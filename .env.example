# .env.example
# Copie este arquivo para .env e preencha com valores reais.

# Postgres connection (inside Docker network)
POSTGRES_USER=urbs_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=urbs_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Crawler output path — DENTRO do container (mount RW do docker-compose)
# O volume monta /mnt/shared/.../crawler-dadosabertos-cwb:/app/crawler:rw
# entao dentro do container os arquivos .xz ficam em /app/crawler/downloads
CRAWLER_OUTPUT_PATH=/app/crawler/downloads

# Ingestion schedule (HH:MM, default 02:00 diário)
# Interpretado no timezone America/Sao_Paulo (Brasil), nao no UTC do container.
# Exemplo: 02:00 = 2h da manhã de Brasília
INGESTION_SCHEDULE=02:00
